# Copy to .env.local for `npm run dev`, or set these in Vercel's Project Settings ->
# Environment Variables when deploying. One Vercel project serves both the Vite SPA
# and the api/*.ts serverless functions, so both groups below live in the same place.

# ---------------------------------------------------------------------------
# Client (VITE_*) — Vite inlines these into the shipped JS bundle. They are PUBLIC:
# anyone who opens the site can read them. Never put a secret behind a VITE_ prefix.
# ---------------------------------------------------------------------------

# MizanRegistry on Sepolia. Optional — defaults to the deployed address in
# smart-contract/deployments/sepolia.json if unset.
VITE_MIZAN_REGISTRY_ADDRESS=0xAB7995471D8f075AE357c47AF884Ac814e6dBB38

# Sepolia RPC the browser reads from directly. Optional — defaults to a free public
# endpoint (ethereum-sepolia-rpc.publicnode.com). Set your own if you hit rate limits.
# VITE_SEPOLIA_RPC_URL=https://your-provider.example/v3/your-key

# Base path for the dashboard's own API (propose/sign/pending). Optional — defaults to
# `/api`, same-origin, which is correct for the normal single-project Vercel deploy.
# VITE_MIZAN_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# Server (api/*.ts, Vercel Edge Functions) — never exposed to the browser.
# ---------------------------------------------------------------------------

# RPC used for server-side on-chain reads (board membership, quorum, resolve()).
# Required. A free public endpoint works for the demo's traffic; your own Infura/
# Alchemy project is safer for anything beyond that.
SEPOLIA_RPC_URL=https://your-provider.example/v3/your-key

# MizanRegistry on Sepolia. Optional — same default as VITE_MIZAN_REGISTRY_ADDRESS above.
# MIZAN_REGISTRY_ADDRESS=0xAB7995471D8f075AE357c47AF884Ac814e6dBB38

# Shared secret the board-opinion CRE workflow sends back when it marks a proposal
# resolved (POST /api/resolve). Required — generate any random string and set the
# identical value as WORKFLOW_RESOLVE_SECRET in cre-workflow's secrets (see
# cre-workflow/secrets.yaml.example). Without it, nothing can close out a delivered
# proposal.
WORKFLOW_RESOLVE_SECRET=

# Upstash/Vercel KV REST credentials. Strongly recommended in production — without
# them, pending-proposal state lives in a per-invocation in-memory store that does
# not persist or coordinate across Vercel's serverless instances. Get these from
# Vercel's "KV" storage integration (Upstash-backed) or a free Upstash account.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
