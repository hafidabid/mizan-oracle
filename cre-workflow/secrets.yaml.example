# Copy this file to secrets.yaml (already gitignored). secretsNames maps a
# secret id to the NAME of an environment variable CRE reads the value
# from at runtime — do not put a literal key value here.
# Export the real values separately, e.g. in the repo-root `secrets` file:
#   OPENROUTER_API_KEY=sk-or-v1-your-real-key
#   WORKFLOW_RESOLVE_SECRET=some-random-string-shared-with-the-dashboard-api
secretsNames:
  openrouter_api_key:
    - OPENROUTER_API_KEY
  workflow_resolve_secret:
    - WORKFLOW_RESOLVE_SECRET
